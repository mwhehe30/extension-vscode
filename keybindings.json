[
  // =========================
  // EDITOR — BASIC MOVE
  // =========================
  {
    "key": "alt+j",
    "command": "cursorLeft",
    "when": "textInputFocus",
  },
  {
    "key": "alt+k",
    "command": "cursorDown",
    "when": "textInputFocus",
  },
  {
    "key": "alt+l",
    "command": "cursorUp",
    "when": "textInputFocus",
  },
  {
    "key": "alt+;",
    "command": "cursorRight",
    "when": "textInputFocus",
  },

  // =========================
  // EDITOR — HOME / END (BARIS)
  // =========================
  {
    "key": "alt+shift+j",
    "command": "cursorHome",
    "when": "textInputFocus",
  },
  {
    "key": "alt+shift+;",
    "command": "cursorEnd",
    "when": "textInputFocus",
  },

  // =========================
  // EDITOR — TOP / BOTTOM FILE
  // =========================
  {
    "key": "shift+alt+l",
    "command": "cursorTop",
    "when": "textInputFocus",
  },
  {
    "key": "shift+alt+k",
    "command": "cursorBottom",
    "when": "textInputFocus",
  },

  // =========================
  // LIST / SIDEBAR / POPUP
  // =========================
  {
    "key": "alt+l",
    "command": "list.focusUp",
    "when": "listFocus || sideBarFocus",
  },
  {
    "key": "alt+k",
    "command": "list.focusDown",
    "when": "listFocus || sideBarFocus",
  },
]
