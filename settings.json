{
  "workbench.sideBar.location": "right",
  "workbench.editor.editorActionsLocation": "default",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[php]": {
    "editor.defaultFormatter": "DEVSENSE.phptools-vscode",
  },
  // "workbench.statusBar.visible": false,
  "workbench.tips.enabled": false,
  "workbench.colorCustomizations": {
    "editorGroup.border": "#00000000",
    "widget.shadow": "#00000000",
    "editorGroup.dropBackground": "#00000000",
    "panel.border": "#00000000",
    "sideBar.border": "#00000000",
    // "statusBar.background": "#4d9375",
    // "statusBar.noFolderBackground": "#4d9375",
    // "statusBar.debuggingBackground": "#4d9375",
    // "statusBar.foreground": "#1F2335",
    // "statusBar.debuggingForeground": "#1F2335",
    "scrollbarSlider.background": "#00000000",
    "scrollbarSlider.hoverBackground": "#00000000",
    "scrollbarSlider.activeBackground": "#00000000",
    "scrollbar.shadow": "#00000000",
    "terminal.border": "#00000000",
  },
  "editor.selectionHighlight": false,
  "editor.occurrencesHighlight": "off",
  "editor.formatOnSave": true,
  "editor.fontFamily": "Cascadia Code, Consolas",
  "editor.fontLigatures": "'calt', 'ss01', 'ss02', 'ss03', 'ss19', 'ss20'",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "window.menuBarVisibility": "hidden",
  "editor.minimap.renderCharacters": false,
  "editor.minimap.enabled": false,
  "workbench.editor.enablePreview": false,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "solid",
  "editor.semanticHighlighting.enabled": true,
  "editor.overtypeCursorStyle": "underline",
  "editor.cursorStyle": "underline",
  "workbench.editor.showTabs": "single",
  "breadcrumbs.enabled": false,
  "editor.fontWeight": "500",
  "material-icon-theme.hidesExplorerArrows": true,
  "workbench.editor.empty.hint": "hidden",
  "explorer.confirmDelete": false,
  "editor.wordWrap": "on",
  "workbench.tree.indent": 12,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "editor.guides.indentation": false,
  "editor.showFoldingControls": "never",
  "files.trimTrailingWhitespace": true,
  "editor.hover.enabled": false,
  "editor.stickyScroll.enabled": false,
  "editor.lineHeight": 1.7,
  "editor.multiCursorModifier": "ctrlCmd",
  "workbench.tree.enableStickyScroll": false,
  "editor.mouseWheelZoom": true,
  "editor.tabSize": 2,

  "window.zoomLevel": 1,

  "terminal.integrated.cursorStyle": "underline",
  "terminal.integrated.cursorBlinking": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "files.insertFinalNewline": true,

  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerBorder": false,
  "editor.renderWhitespace": "none",
  "editor.snippetSuggestions": "top",
  "editor.lightbulb.enabled": "off",
  "breadcrumbs.filePath": "on",
  "breadcrumbs.symbolPath": "off",
  "workbench.startupEditor": "none",
  "workbench.tree.renderIndentGuides": "none",
  "explorer.compactFolders": false,
  "scm.diffDecorations": "all",
  "explorer.confirmDragAndDrop": false,
  "bladeFormatter.format.phpVersion": "8.3",

  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell",
    },
    "Git Bash": {
      "path": "C:\\git\\bin\\bash.exe",
      "args": ["--login", "-i"],
      "icon": "terminal-bash",
    },
  },
  "workbench.layoutControl.enabled": false,
  "window.commandCenter": false,
  "workbench.iconTheme": "material-icon-theme",
  "prettier.singleQuote": true,
  "files.eol": "\n",
  "workbench.preferredDarkColorTheme": "Vitesse Dark",
  "workbench.activityBar.location": "hidden",
  "fiveServer.php.executable": "C:\\laragon\\bin\\php\\php-8.3.28-Win32-vs16-x64\\php.exe",
  "fiveServer.php.ini": "C:\\laragon\\bin\\php\\php-8.3.28-Win32-vs16-x64\\php.ini",
  "workbench.colorTheme": "Vitesse Dark",
